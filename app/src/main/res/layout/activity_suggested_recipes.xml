<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F7F5EC">

    <TextView
        android:id="@+id/txtSuggestedTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🍲 Recipe Corner"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#245A40"
        android:paddingBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Delicious ideas using what you have!"
        android:textSize="15sp"
        android:textColor="#657565"
        android:paddingBottom="20dp" />

    <TextView
        android:id="@+id/txtNoRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌱 No matching recipes yet.\nAdd the ingredients and quantities you need to your pantry, then check again!"
        android:textSize="16sp"
        android:textColor="#245A40"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/listViewRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DCE5D8"
        android:dividerHeight="1dp" />

</LinearLayout>
