<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5EC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🍲 Recipe Name"
            android:textColor="#245A40"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Let's make something delicious!"
            android:textColor="#657565"
            android:textSize="15sp"
            android:paddingBottom="24dp" />

        <!-- Ingredients card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/pantry_item_card"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🥬 Ingredients"
                android:textColor="#245A40"
                android:textSize="21sp"
                android:textStyle="bold"
                android:paddingBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Everything you need for this recipe"
                android:textColor="#657565"
                android:textSize="14sp"
                android:paddingBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#DCE6D8"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/txtRecipeIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recipe ingredients will appear here."
                android:textColor="#344638"
                android:textSize="16sp"
                android:lineSpacingExtra="8dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <!-- Instructions card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/pantry_item_card"
            android:padding="18dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👩🏽‍🍳 Instructions"
                android:textColor="#245A40"
                android:textSize="21sp"
                android:textStyle="bold"
                android:paddingBottom="12dp" />

            <TextView
                android:id="@+id/txtRecipeInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recipe instructions will appear here."
                android:textColor="#344638"
                android:textSize="16sp"
                android:lineSpacingExtra="7dp"
                android:paddingBottom="4dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnBackToRecipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="← Back to Suggested Recipes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#245A40" />

    </LinearLayout>

</ScrollView>
