<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F7F5EC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ My Space"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#245A40"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Make your pantry experience your own. 🌿"
            android:textSize="15sp"
            android:textColor="#657565"
            android:layout_marginBottom="28dp" />

        <!-- Profile section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 My Profile"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#245A40"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/editTextProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your name"
            android:inputType="textPersonName"
            android:minHeight="52dp"
            android:padding="14dp"
            android:backgroundTint="#8BAF87" />

        <EditText
            android:id="@+id/editTextProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your email"
            android:inputType="textEmailAddress"
            android:minHeight="52dp"
            android:padding="14dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#8BAF87" />

        <Button
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:text="SAVE PROFILE"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:backgroundTint="#245A40"
            android:textColor="#FFFFFF" />

        <!-- Preferences section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔 Preferences"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#245A40"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/switchNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:text="Enable notifications"
            android:textSize="16sp"
            android:padding="8dp"
            android:thumbTint="#245A40"
            android:trackTint="#8BAF87" />

        <!-- About section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🌱 About Smart Pantry"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#245A40"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Smart Pantry Manager helps you organise your pantry, track ingredient quantities, and discover delicious recipes using what you already have. Less waste, smarter cooking!"
            android:textSize="15sp"
            android:textColor="#657565"
            android:lineSpacingExtra="5dp" />

        <Button
            android:id="@+id/btnClearPantry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:text="CLEAR PANTRY"
            android:textStyle="bold"
            android:layout_marginTop="28dp"
            android:backgroundTint="#A94442"
            android:textColor="#FFFFFF" />

    </LinearLayout>

</ScrollView>
